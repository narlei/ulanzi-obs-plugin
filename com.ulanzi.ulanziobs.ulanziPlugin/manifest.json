{
  "Author": "Jason Schwefel",
  "Name": "OBS Control",
  "Description": "Control OBS Studio from the Ulanzi D200X with live state on the keys (REC / MIC OFF / scene) plus mic gain on an encoder. JS port of the MX OBS plugin.",
  "Icon": "assets/icons/pluginIcon.png",
  "Category": "OBS Control",
  "CategoryIcon": "assets/icons/category.png",
  "CodePath": "dist/app.js",
  "Type": "JavaScript",
  "Inspect": "--inspect=127.0.0.1:9231",
  "PrivateAPI": true,
  "UUID": "com.ulanzi.ulanzistudio.ulanziobs",
  "Actions": [
    {
      "Name": "Record",
      "Icon": "assets/actions/record.svg",
      "state": 0,
      "States": [
        {
          "Name": "Idle",
          "Image": "assets/actions/record_off.png"
        },
        {
          "Name": "Recording",
          "Image": "assets/actions/record_on.png"
        }
      ],
      "Tooltip": "Start / stop OBS recording",
      "UUID": "com.ulanzi.ulanzistudio.ulanziobs.record",
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "Controllers": [
        "Keypad"
      ],
      "Devices": []
    },
    {
      "Name": "Mute",
      "Icon": "assets/actions/mic.svg",
      "PropertyInspectorPath": "property-inspector/mute/inspector.html",
      "state": 0,
      "States": [
        {
          "Name": "Live",
          "Image": "assets/actions/mute_off.png"
        },
        {
          "Name": "Muted",
          "Image": "assets/actions/mute_on.png"
        }
      ],
      "Tooltip": "Toggle mute on the mic input",
      "UUID": "com.ulanzi.ulanzistudio.ulanziobs.mute",
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "Controllers": [
        "Keypad"
      ],
      "Devices": []
    },
    {
      "Name": "Studio",
      "Icon": "assets/actions/studio.svg",
      "state": 0,
      "States": [
        {
          "Name": "Off",
          "Image": "assets/actions/studio_off.png"
        },
        {
          "Name": "On",
          "Image": "assets/actions/studio_on.png"
        }
      ],
      "Tooltip": "Toggle OBS Studio Mode",
      "UUID": "com.ulanzi.ulanzistudio.ulanziobs.studio",
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "Controllers": [
        "Keypad"
      ],
      "Devices": []
    },
    {
      "Name": "Take",
      "Icon": "assets/actions/transition.svg",
      "state": 0,
      "States": [
        {
          "Name": "Rest",
          "Image": "assets/actions/take_off.png"
        },
        {
          "Name": "Flash",
          "Image": "assets/actions/take_on.png"
        }
      ],
      "Tooltip": "Transition Preview to Program (green flash on press)",
      "UUID": "com.ulanzi.ulanzistudio.ulanziobs.take",
      "SupportedInMultiActions": true,
      "DisableAutomaticStates": true,
      "Controllers": [
        "Keypad"
      ],
      "Devices": []
    },
    {
      "Name": "BRB",
      "Icon": "assets/actions/brb.svg",
      "PropertyInspectorPath": "property-inspector/brb/inspector.html",
      "state": 0,
      "States": [
        {
          "Name": "Inactive",
          "Image": "assets/actions/brb_inactive.png"
        },
        {
          "Name": "Preview",
          "Image": "assets/actions/brb_preview.png"
        },
        {
          "Name": "Live",
          "Image": "assets/actions/brb_live.png"
        }
      ],
      "Tooltip": "Cut Program to the next Be-Right-Back scene (cycles BRB-prefixed scenes)",
      "UUID": "com.ulanzi.ulanzistudio.ulanziobs.brb",
      "SupportedInMultiActions": true,
      "DisableAutomaticStates": true,
      "Controllers": [
        "Keypad"
      ],
      "Devices": []
    },
    {
      "Name": "Scene",
      "Icon": "assets/actions/scenes.svg",
      "PropertyInspectorPath": "property-inspector/scene/inspector.html",
      "state": 0,
      "States": [
        {
          "Name": "MonitorInactive",
          "Image": "assets/actions/scene_monitor_inactive.png"
        },
        {
          "Name": "MonitorPreview",
          "Image": "assets/actions/scene_monitor_preview.png"
        },
        {
          "Name": "MonitorLive",
          "Image": "assets/actions/scene_monitor_live.png"
        },
        {
          "Name": "CameraInactive",
          "Image": "assets/actions/scene_camera_inactive.png"
        },
        {
          "Name": "CameraPreview",
          "Image": "assets/actions/scene_camera_preview.png"
        },
        {
          "Name": "CameraLive",
          "Image": "assets/actions/scene_camera_live.png"
        },
        {
          "Name": "WebcamInactive",
          "Image": "assets/actions/scene_webcam_inactive.png"
        },
        {
          "Name": "WebcamPreview",
          "Image": "assets/actions/scene_webcam_preview.png"
        },
        {
          "Name": "WebcamLive",
          "Image": "assets/actions/scene_webcam_live.png"
        }
      ],
      "Tooltip": "Switch to a scene (Preview in Studio Mode, else Program)",
      "UUID": "com.ulanzi.ulanzistudio.ulanziobs.scene",
      "SupportedInMultiActions": true,
      "DisableAutomaticStates": true,
      "Controllers": [
        "Keypad"
      ],
      "Devices": []
    },
    {
      "Name": "Mic Gain",
      "Icon": "assets/actions/mic.svg",
      "PropertyInspectorPath": "property-inspector/micgain/inspector.html",
      "state": 0,
      "States": [
        {
          "Name": "Gain",
          "Image": "assets/actions/micgain.png"
        }
      ],
      "Tooltip": "Rotate to adjust mic gain (dB); press to reset to 0 dB",
      "UUID": "com.ulanzi.ulanzistudio.ulanziobs.micgain",
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "$UA1"
      },
      "Devices": []
    }
  ],
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "10.11"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Software": {
    "MinVersion": "2.1.4"
  },
  "ApplicationsToMonitor": {
    "mac": [
      "com.obsproject.obs-studio"
    ],
    "windows": [
      "obs32.exe",
      "obs64.exe"
    ]
  }
}
